use serde::Deserialize;
use std::fs;
/// Represents the node configuration loaded from a YAML file,
/// including identity, networking details, and public key info.
#[derive(Debug, Deserialize)]
struct NodeConfig {
    node_id: String,
    hostname: String,
    ip: String,
    port: u16,
    public_key: String,
}
/// Loads a YAML configuration file and deserializes it
/// into a `NodeConfig` struct. Panics if the file is missing or invalid.
fn load_config(path: &str) -> NodeConfig {
    let data = fs::read_to_string(path).expect("Failed to read config");
    serde_yaml::from_str::<NodeConfig>(&data).expect("Invalid YAML")
}
