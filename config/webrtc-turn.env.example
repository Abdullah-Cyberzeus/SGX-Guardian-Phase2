# Copy this value into /etc/sgx-guardian/node_profile on each board.
# Use authenticated, regularly rotated credentials; never embed them in React.
# Multiple STUN/TURN URLs can be supplied for UDP, TCP, and TLS fallback.
SGX_WEBRTC_ICE_SERVERS='[{"urls":["stun:turn.example.com:3478","turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp","turns:turn.example.com:5349?transport=tcp"],"username":"replace-with-turn-username","credential":"replace-with-turn-credential"}]'
