# Netbridge dnsmasq configuration template
# Variables in {} will be replaced by the netbridge orchestrator at runtime.

# --- Network Interface ---
# The interface to bind to (e.g. ap0)
interface={INTERFACE}
bind-interfaces
except-interface=lo

# --- DHCP Settings ---
# Assign IP addresses in the specified range with a 12h lease time
# Default range: 192.168.200.100 - 192.168.200.254
dhcp-range={DHCP_RANGE_START},{DHCP_RANGE_END},255.255.255.0,12h

# Explicitly set the lease file location so we can reliably parse connected clients
dhcp-leasefile=/tmp/netbridge/dnsmasq.leases

# Set the default gateway (router) to this device (e.g. 192.168.200.1)
dhcp-option=3,{GATEWAY_IP}

# Set the DNS server to this device
dhcp-option=6,{GATEWAY_IP}

# --- DNS Resolver Settings ---
# Canonical Guardian FQDN (for example nodea.guardian)
domain={LOCAL_DOMAIN}
local=/{LOCAL_DOMAIN}/
# Resolve the canonical node name directly to the hotspot gateway. `domain=` alone
# assigns a DHCP search domain but does not create this host record.
address=/{LOCAL_DOMAIN}/{GATEWAY_IP}

# Secure upstream DNS servers (Cloudflare & Quad9)
server=1.1.1.1
server=9.9.9.9

# Don't forward plain names (without a dot or domain part)
domain-needed
# Never forward addresses in the non-routed address spaces
bogus-priv
# Don't read /etc/resolv.conf or /etc/hosts to prevent local poisoning
no-resolv
no-hosts

# Enable caching and query logging for threat analysis
cache-size=1000
log-queries

# --- DNS Security & Blocklists ---
# Block malicious/tracker/C2 domains by routing them to 0.0.0.0 (Sinkhole).
# External blocklist files (e.g. tracking.conf, malware.conf) should be dropped into this directory.
conf-dir=/etc/sgx-guardian/dnsmasq.d/,*.conf
