# =============================================================================
# SG-X Guardian - agent image (multi-arch: linux/amd64, linux/arm64)
#   builder      : pinned Rust toolchain; also the CI test environment
#   nebula-fetch : downloads + verifies the Nebula mesh binaries for TARGETARCH
#   runtime      : slim Debian + runtime tools; runs the real daemon
# =============================================================================

ARG RUST_IMAGE=rust:1.90-bookworm
ARG NODE_IMAGE=node:22-bookworm-slim
ARG RUNTIME_IMAGE=debian:bookworm-slim
ARG NEBULA_VERSION=1.9.4

# Build the React application inside Docker. The Rust build embeds this output
# into the daemon binary, so it must never depend on a stale host-side dist/.
FROM ${NODE_IMAGE} AS frontend-builder

ARG VITE_CYLENIUM_BASE_URL=http://localhost:4000
ARG VITE_CYLENIUM_CLIENT_ID
ARG VITE_CYLENIUM_SCOPE="openid profile email"

WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# The same image runs nodeA, nodeB, and nodeC. Keep API requests relative to
# the page origin so :18443 uses nodeA, :28443 uses nodeB, and :38443 uses
# nodeC. Explicit values also prevent a developer's local frontend/.env from
# being baked into the production bundle.
RUN VITE_API_ROOT=/api/v1 \
    VITE_API_URL=/api/v1 \
    VITE_CYLENIUM_BASE_URL="${VITE_CYLENIUM_BASE_URL}" \
    VITE_CYLENIUM_CLIENT_ID="${VITE_CYLENIUM_CLIENT_ID}" \
    VITE_CYLENIUM_SCOPE="${VITE_CYLENIUM_SCOPE}" \
    npm run build \
    && test -s dist/index.html \
    && grep -q 'type="module"' dist/index.html \
    && ! grep -q '/src/main.tsx' dist/index.html \
    && ! grep -R -qE 'https?://(127\.0\.0\.1|localhost):[0-9]+/api/v1' dist

FROM ${RUST_IMAGE} AS builder

# protoc: required by tonic-prost-build in build.rs
# cmake + pkg-config: mirror scripts/build.sh prerequisites closely
RUN apt-get update && apt-get install -y --no-install-recommends \
        protobuf-compiler cmake pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .
COPY --from=frontend-builder /src/frontend/dist /src/frontend/dist

# Keep the workspace contract aligned with CI and scripts/build.sh. `build.rs`
# embeds hashed frontend files, so clear this package from the target cache
# before compiling to avoid reusing a generated map from an older frontend build.
# Cache mounts persist cargo's registry + incremental build artifacts across
# `docker build` invocations even though `COPY . .` above invalidates the
# layer cache on every source change. They're excluded from the committed
# layer, so the built binaries are copied out to /out before this RUN ends.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo clean -p sgx_guardian_client --release && \
    cargo build --release --workspace --locked --features tpm && \
    mkdir -p /out && \
    cp target/release/sgx_guardian_client target/release/sgx-pa-cli target/release/sgx-broker /out/

# =============================================================================
# Nebula is fetched per-TARGETARCH (not vendored) so the same Dockerfile is
# correct on both the x86_64 dev/NUC cohort and the aarch64 boards. Version +
# checksums are pinned; build fails on download error, checksum mismatch,
# missing binary, or an ELF machine type that doesn't match TARGETARCH.
# SGX_DISABLE_NEBULA=1 remains the runtime escape hatch either way.
# =============================================================================
FROM debian:bookworm-slim AS nebula-fetch
ARG NEBULA_VERSION
ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /nebula-src

# Pinned per-arch tarball checksums (nebula v${NEBULA_VERSION} release SHASUM256.txt).
# Bump NEBULA_VERSION and both hashes together when upgrading.
RUN set -eu; \
    case "${TARGETARCH}" in \
        amd64) NEBULA_SHA256="2216dfab57c0c387a762f788a1d6c4609c73bb56c24053396e01a56f70328d9a"; EXPECT_MACHINE="3e00" ;; \
        arm64) NEBULA_SHA256="ae531ce56b5cf9e65f4e5ce19719b7861e2c7137d3b57a713e1879a545a9a2d6"; EXPECT_MACHINE="b700" ;; \
        *) echo "ERROR: unsupported TARGETARCH '${TARGETARCH}' for Nebula" >&2; exit 1 ;; \
    esac; \
    TARBALL="nebula-linux-${TARGETARCH}.tar.gz"; \
    URL="https://github.com/slackhq/nebula/releases/download/v${NEBULA_VERSION}/${TARBALL}"; \
    echo "Fetching ${URL}"; \
    curl --proto '=https' --tlsv1.2 -fSL \
        --retry 10 --retry-all-errors --retry-delay 2 --retry-max-time 900 \
        --connect-timeout 20 --max-time 900 --continue-at - \
        -o "${TARBALL}" "${URL}"; \
    echo "${NEBULA_SHA256}  ${TARBALL}" | sha256sum -c -; \
    tar -xzf "${TARBALL}"; \
    [ -f nebula ] && [ -f nebula-cert ] || { echo "ERROR: nebula binary missing after extraction" >&2; exit 1; }; \
    for bin in nebula nebula-cert; do \
        actual="$(od -An -tx1 -j18 -N2 "$bin" | tr -d ' \n')"; \
        [ "$actual" = "$EXPECT_MACHINE" ] || { echo "ERROR: $bin ELF e_machine=$actual, expected $EXPECT_MACHINE for $TARGETARCH" >&2; exit 1; }; \
    done; \
    chmod 0755 nebula nebula-cert; \
    rm -f "${TARBALL}"

FROM ${RUNTIME_IMAGE} AS runtime

# nftables        : enforcement executor shells out to `nft -f`
# procps          : daemon uses pkill/pgrep for nebula lifecycle
# iproute2        : `ip`/`ss` for interface verification + debugging
# ca-certificates : outbound TLS trust
# curl            : healthchecks + in-container smoke tests
# nmap            : discovery scheduler/API shell out to it at runtime
# tpm2-tools      : TPM diagnostics and runtime verification
# libtss2-*       : TPM2 TSS runtime libraries and device TCTI support
RUN apt-get update && apt-get install -y --no-install-recommends \
        nftables ca-certificates procps iproute2 curl nmap \
        tpm2-tools \
        libtss2-esys-3.0.2-0 \
        libtss2-tcti-device0 \
        libtss2-tctildr0 \
        libtss2-mu0 \
        libtss2-rc0 \
        libtss2-sys1 \
    && rm -rf /var/lib/apt/lists/*

# Nebula fetched + checksum + ELF-arch verified per TARGETARCH in nebula-fetch (see above).
COPY --from=nebula-fetch /nebula-src/nebula /usr/local/bin/nebula
COPY --from=nebula-fetch /nebula-src/nebula-cert /usr/local/bin/nebula-cert
RUN chmod 0755 /usr/local/bin/nebula /usr/local/bin/nebula-cert

# Keep canonical binary names so existing workflows and logs stay familiar.
COPY --from=builder /out/sgx_guardian_client /usr/local/bin/sgx_guardian_client
COPY --from=builder /out/sgx-pa-cli /usr/local/bin/sgx-pa-cli
COPY --from=builder /out/sgx-broker /usr/local/bin/sgx-broker
COPY docker/entrypoint.sh /usr/local/bin/sgx-entrypoint
RUN chmod 0755 /usr/local/bin/sgx-entrypoint

VOLUME ["/etc/sgx-guardian", "/var/lib/sgx-guardian", "/var/log/sgx-guardian"]

# gRPC 50051-50053 | cert bootstrap 50061 | registry 50062 | CRL gossip 50063
# REST 8443 | discovery UDP 9000 | nebula UDP 4242 | attestation 50151-50153
EXPOSE 50051-50053 50061-50063 8443 50151-50153 9000/udp 4242/udp

WORKDIR /var/lib/sgx-guardian
ENTRYPOINT ["/usr/local/bin/sgx-entrypoint"]
CMD ["nodeA"]
