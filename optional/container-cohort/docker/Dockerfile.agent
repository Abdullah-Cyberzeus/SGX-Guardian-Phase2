# syntax=docker/dockerfile:1.7
# =============================================================================
# SG-X Guardian - agent image (x86_64)
#   builder : pinned Rust toolchain; also the CI test environment
#   runtime : slim Debian + runtime tools; runs the real daemon
# =============================================================================

ARG RUST_IMAGE=rust:1.90-bookworm
ARG RUNTIME_IMAGE=debian:bookworm-slim

FROM ${RUST_IMAGE} AS builder

ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse \
    CARGO_NET_RETRY=10 \
    CARGO_HTTP_TIMEOUT=120

# protoc: required by tonic-prost-build in build.rs
# cmake + pkg-config: mirror scripts/build.sh prerequisites closely
RUN apt-get update && apt-get install -y --no-install-recommends \
        protobuf-compiler cmake pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Cache dependency resolution separately from source changes so rebuilds only
# fetch new crates when Cargo manifests or the lockfile actually change.
COPY Cargo.lock build.rs ./
COPY optional/container-cohort/overlay/Cargo.toml ./Cargo.toml
COPY sgx-pa-cli/Cargo.toml ./sgx-pa-cli/Cargo.toml
COPY src/lib.rs ./src/lib.rs
COPY sgx-pa-cli/src/lib.rs ./sgx-pa-cli/src/lib.rs
RUN --mount=type=cache,id=sgx-cohort-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=sgx-cohort-cargo-git,target=/usr/local/cargo/git \
    cargo fetch --locked

COPY . .
COPY optional/container-cohort/overlay/ /src/

# Persist cargo's registry/git/target caches across docker builds so source
# edits do not force crates.io downloads or a completely cold rebuild.
RUN --mount=type=cache,id=sgx-cohort-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=sgx-cohort-cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=sgx-cohort-target,target=/src/target \
    cargo build --release --workspace --locked --features virtual-platform

FROM ${RUNTIME_IMAGE} AS runtime

# nftables        : enforcement executor shells out to `nft -f`
# procps          : daemon uses pkill/pgrep for nebula lifecycle
# iproute2        : `ip`/`ss` for interface verification + debugging
# ca-certificates : outbound TLS trust
# curl            : healthchecks + in-container smoke tests
# nmap            : discovery scheduler/API shell out to it at runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
        nftables ca-certificates procps iproute2 curl nmap softhsm2 \
    && rm -rf /var/lib/apt/lists/*

# Nebula mesh binaries are vendored in-repo so image builds do not depend on GitHub.
COPY optional/container-cohort/docker/vendor/nebula /usr/local/bin/nebula
COPY optional/container-cohort/docker/vendor/nebula-cert /usr/local/bin/nebula-cert
RUN chmod 0755 /usr/local/bin/nebula /usr/local/bin/nebula-cert \
    && nebula -version

# Keep canonical binary names so existing workflows and logs stay familiar.
COPY --from=builder /src/target/release/sgx_guardian_client /usr/local/bin/sgx_guardian_client
COPY --from=builder /src/target/release/sgx-pa-cli /usr/local/bin/sgx-pa-cli
COPY optional/container-cohort/docker/entrypoint.sh /usr/local/bin/sgx-entrypoint
RUN chmod 0755 /usr/local/bin/sgx-entrypoint

VOLUME ["/etc/sgx-guardian", "/var/lib/sgx-guardian", "/var/log/sgx-guardian"]

# gRPC 50051-50053 | cert bootstrap 50061 | registry 50062 | CRL gossip 50063
# REST 8443 | discovery UDP 9000 | nebula UDP 4242 | attestation 50151-50153
EXPOSE 50051-50053 50061-50063 8443 50151-50153 9000/udp 4242/udp

WORKDIR /var/lib/sgx-guardian
ENTRYPOINT ["/usr/local/bin/sgx-entrypoint"]
CMD ["nodeA"]
