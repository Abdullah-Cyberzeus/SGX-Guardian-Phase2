[Unit]
Description=SGX Guardian Client (Zero-Trust Edge Security Agent)
Documentation=https://github.com/AsadAli-CyberZeus/SGX
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ---- Security: Least Privilege ----
User=sgxguardian
Group=sgxguardian

# ---- Binary ----
EnvironmentFile=-/etc/sgx-guardian/node_profile
ExecStart=/usr/bin/sgx-guardian ${SGX_NODE_ID:-nodeA}

# ---- Restart Policy ----
Restart=on-failure
RestartSec=5s

# ---- File System Access ----
WorkingDirectory=/var/lib/sgx-guardian
ReadWritePaths=/var/lib/sgx-guardian /var/log/sgx-guardian
ReadOnlyPaths=/etc/sgx-guardian /etc/suricata

# ---- Hardening (Very Important) ----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

# ---- Networking ----
# Network filtering handled by nftables rules in enforcement/executor.rs and
# threat/blocker.rs. Do not add IPAddressDeny/IPAddressAllow here or Nebula
# overlay traffic will break.

# ---- Logging ----
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sgx-guardian

[Install]
WantedBy=multi-user.target
