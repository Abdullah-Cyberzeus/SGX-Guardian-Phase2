#!/bin/sh
set -e

USER=sgxguardian
GROUP=sgxguardian

DATA_DIR=/var/lib/sgx-guardian
LOG_DIR=/var/log/sgx-guardian
CONFIG_DIR=/etc/sgx-guardian

echo "SGX Guardian post-install started..."

# ---- Create system user & group (idempotent) ----
if ! getent group "$GROUP" >/dev/null; then
    groupadd --system "$GROUP"
fi

if ! getent passwd "$USER" >/dev/null; then
    useradd --system \
        --gid "$GROUP" \
        --home "$DATA_DIR" \
        --shell /usr/sbin/nologin \
        "$USER"
fi

# ---- Create directories safely ----
mkdir -p "$DATA_DIR" "$LOG_DIR" "$CONFIG_DIR"

# ---- Ownership & permissions ----
chown -R "$USER:$GROUP" "$DATA_DIR" "$LOG_DIR"
chmod 750 "$DATA_DIR" "$LOG_DIR"
chmod 755 "$CONFIG_DIR"

# ---- Remove legacy system-wide NMAP capabilities ----
# Network privileges now come only from the sgx-guardian systemd sandbox.
if command -v nmap >/dev/null && command -v getcap >/dev/null && command -v setcap >/dev/null; then
    NMAP_PATH=$(command -v nmap)
    NMAP_CAPS=$(getcap "$NMAP_PATH" 2>/dev/null || true)
    case "$NMAP_CAPS" in
        *"cap_net_admin,cap_net_raw=eip"*|*"cap_net_raw,cap_net_admin=eip"*)
            echo "Removing legacy SGX Guardian file capabilities from nmap..."
            if ! setcap -r "$NMAP_PATH"; then
                echo "WARNING: Failed to remove legacy nmap file capabilities." >&2
            fi
            ;;
    esac
fi

# ---- systemd reload ----
if command -v systemctl >/dev/null; then
    systemctl daemon-reload
    systemctl enable sgx-guardian.service >/dev/null || true
fi

echo "SGX Guardian post-install completed."
exit 0
