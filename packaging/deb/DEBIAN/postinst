#!/bin/sh
set -e

USER=sgxguardian
GROUP=sgxguardian

DATA_DIR=/var/lib/sgx-guardian
LOG_DIR=/var/log/sgx-guardian
CONFIG_DIR=/etc/sgx-guardian

echo "SGX Guardian post-install started..."

# ---- Create system user & group (idempotent) ----
if ! getent group "$GROUP" >/dev/null; then
    groupadd --system "$GROUP"
fi

if ! getent passwd "$USER" >/dev/null; then
    useradd --system \
        --gid "$GROUP" \
        --home "$DATA_DIR" \
        --shell /usr/sbin/nologin \
        "$USER"
fi

# ---- Create directories safely ----
mkdir -p "$DATA_DIR" "$LOG_DIR" "$CONFIG_DIR"

# ---- Ownership & permissions ----
chown -R "$USER:$GROUP" "$DATA_DIR" "$LOG_DIR"
chmod 750 "$DATA_DIR" "$LOG_DIR"
chmod 755 "$CONFIG_DIR"

# ---- NMAP network discovery ----
# sgx-pa-cli's discovery command shells out to nmap directly (outside the
# sgx-guardian systemd sandbox), so it needs its own file capabilities here
# rather than inheriting the daemon's Ambient set.
if command -v nmap >/dev/null && command -v setcap >/dev/null; then
    echo "Configuring nmap capabilities for Sprint 6 NMP-series..."
    if ! setcap cap_net_raw,cap_net_admin+eip "$(command -v nmap)"; then
        echo "WARNING: Failed to set nmap capabilities; discovery scans may be limited." >&2
    fi
fi

# ---- systemd reload ----
if command -v systemctl >/dev/null; then
    systemctl daemon-reload
    systemctl enable sgx-guardian.service >/dev/null || true
fi

echo "SGX Guardian post-install completed."
exit 0
