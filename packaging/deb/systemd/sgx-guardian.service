[Unit]
Description=SGX Guardian Client (Zero-Trust Edge Security Agent)
Documentation=https://github.com/AsadAli-CyberZeus/SGX
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ---- Security: Least Privilege ----
User=sgxguardian
Group=sgxguardian

# ---- Binary ----
ExecStart=/usr/bin/sgx-guardian nodeA

# ---- Restart Policy ----
Restart=on-failure
RestartSec=5s

# ---- File System Access ----
ReadWritePaths=/var/lib/sgx-guardian /var/log/sgx-guardian
ReadOnlyPaths=/etc/sgx-guardian

# ---- Hardening (Very Important) ----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=

# ---- Networking ----
IPAddressDeny=any
IPAddressAllow=localhost

# ---- Logging ----
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sgx-guardian

[Install]
WantedBy=multi-user.target
